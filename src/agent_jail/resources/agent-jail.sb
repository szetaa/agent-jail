;; agent-jail Seatbelt profile (macOS sandbox-exec)
;; Hardened kernel-level sandbox with universal DEFAULT-DENY for writes and user/mount spaces.
;; In SBPL the LAST matching rule wins, BUT only for the same operation name:
;; a deny on file-read-data beats an allow on file-read*, so allows must use file-read-data too.
(version 1)
(allow default)

;; =========================================================================
;; 1. UNIVERSAL WRITE POLICY: DENY ALL WRITES EVERYWHERE BY DEFAULT
;; =========================================================================
(deny file-write*)

;; Allow writes ONLY to explicitly needed locations
(allow file-write*
  (subpath (param "RUN_TMP"))
  (subpath (string-append (param "HOME") "/.pi"))
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/tty")
  (literal "/dev/stdout")
  (literal "/dev/stderr")
  (literal "/dev/ptmx")
  (literal "/dev/dtracehelper"))

;; __DYNAMIC_WRITE_RULES__

;; Explicit write denials inside the allowed areas (anti-tampering & persistence traps)
(deny file-write*
  ;; Harness anti-tampering
  (subpath  (string-append (param "HOME") "/.pi/agent/extensions"))
  (subpath  (string-append (param "HOME") "/.pi/agent/skills"))
  (subpath  (string-append (param "HOME") "/.pi/agent/bin"))
  (literal  (string-append (param "HOME") "/.pi/agent/settings.json"))
  (literal  (string-append (param "HOME") "/.pi/agent/models.json"))
  (literal  (string-append (param "HOME") "/.pi/agent/auth.json"))
  ;; Developer delayed-jailbreak traps inside $PROJECT
  (subpath  (string-append (param "PROJECT") "/.git/hooks"))
  (literal  (string-append (param "PROJECT") "/.git/config"))
  (literal  (string-append (param "PROJECT") "/.envrc"))
  (literal  (string-append (param "PROJECT") "/.mcp.json"))
  (subpath  (string-append (param "PROJECT") "/.vscode"))
  ;; Config anti-tampering
  (literal  (string-append (param "PROJECT") "/aj-conf.yaml"))
  (literal  (string-append (param "PROJECT") "/aj-conf.yml"))
  (literal  (string-append (param "PROJECT") "/aj-conf.toml"))
  ;; Network policy anti-tampering
  (literal  (string-append (param "PROJECT") "/.allowed_domains"))
  (literal  (string-append (param "PROJECT") "/.allowed_domains.txt")))

;; =========================================================================
;; 2. READ ACCESS POLICY: BLANKET DENY ON ALL USER DATA & MOUNT TREES
;; =========================================================================
;; Deny reading all user accounts, external mounts, and network shares
(deny file-read-data
  (subpath "/Users")
  (subpath "/Volumes")
  (subpath "/net"))

;; Re-allow reading ONLY temp dir, Pi state, and standard language runtimes:
(allow file-read-data
  (subpath (param "RUN_TMP"))
  (subpath (string-append (param "HOME") "/.pi"))
  (subpath (string-append (param "HOME") "/.local"))
  (subpath (string-append (param "HOME") "/.cache"))
  (subpath (string-append (param "HOME") "/Library/Caches/uv"))
  (subpath (string-append (param "HOME") "/Library/Application Support/uv"))
  (subpath (string-append (param "HOME") "/.pyenv"))
  (subpath (string-append (param "HOME") "/.nvm"))
  (subpath (string-append (param "HOME") "/.fnm"))
  (subpath (string-append (param "HOME") "/.volta"))
  (subpath (string-append (param "HOME") "/.bun"))
  (subpath (string-append (param "HOME") "/.cargo"))
  (subpath (string-append (param "HOME") "/.rustup")))

;; __DYNAMIC_READ_RULES__

;; __DYNAMIC_HIDE_RULES__

;; =========================================================================
;; 3. IPC & OS SECURITY
;; =========================================================================
;; Block reading macOS clipboard (pasteboard) and SecurityServer (keychain daemon)
(deny mach-lookup
  (global-name "com.apple.pasteboard.1")
  (global-name "com.apple.SecurityServer"))

;; =========================================================================
;; 4. NETWORK CONTAINMENT
;; =========================================================================
;; Drop all raw outbound network except dynamic forward proxy and authorized localhost ports
(deny network-outbound)
(allow network-outbound
  (to tcp (string-append "localhost:" (param "PROXY_PORT"))))
